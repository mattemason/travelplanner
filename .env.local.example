# Copy to .env.local and fill in. Never commit .env.local.
# On Railway these are set as service variables instead.

# Railway Postgres (on Railway: DATABASE_URL=${{Postgres.DATABASE_URL}})
DATABASE_URL=

# Seed owner: the Google account the Tasmania trip is created for
SEED_OWNER_EMAIL=

# Auth.js (Google sign-in)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=                      # comma-separated

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY= # Maps JavaScript API only, restricted by HTTP referrer
GOOGLE_MAPS_SERVER_KEY=              # Routes API + Places API (New), server-side only

# Phase 3
ANTHROPIC_API_KEY=
PLAN_BUILDER_MODEL=claude-sonnet-5
