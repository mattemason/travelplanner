# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server and seed script only

# Seed owner: the account the Tasmania trip is created for
SEED_OWNER_EMAIL=

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY= # Maps JavaScript API only, restricted by HTTP referrer
GOOGLE_MAPS_SERVER_KEY=              # Routes API + Places API (New), server-side only

# Phase 3
ANTHROPIC_API_KEY=
PLAN_BUILDER_MODEL=claude-sonnet-5
