# Copy to .env.local and fill in. Never commit .env.local.
# On Railway these are set as service variables instead.

# Railway Postgres (on Railway: DATABASE_URL=${{Postgres.DATABASE_URL}})
DATABASE_URL=

# Seed owner: the sign-in email the Tasmania trip is created for
SEED_OWNER_EMAIL=

# Auth.js (emailed sign-in links)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # openssl rand -base64 32
ALLOWED_EMAILS=                      # comma-separated; nobody else is sent a link

# Postmark (sign-in links and trip notifications)
POSTMARK_SERVER_TOKEN=               # the server's API token, not the account token
EMAIL_FROM=no-reply@socialtap.com.au # must be on the verified domain
POSTMARK_MESSAGE_STREAM=outbound

# Google OAuth (Phase 2: Drive access for Takeout import, not sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY= # Maps JavaScript API only, restricted by HTTP referrer
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=      # JavaScript vector map ID (needed for Advanced Markers)
GOOGLE_MAPS_SERVER_KEY=              # Routes API + Places API (New), server-side only

# Claude (stop info chat now; plan builder in Phase 3). Server-side only.
ANTHROPIC_API_KEY=
STOP_INFO_MODEL=claude-opus-5        # optional; this is the default
PLAN_BUILDER_MODEL=claude-sonnet-5
